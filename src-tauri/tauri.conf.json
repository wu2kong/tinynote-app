{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TinyNote",
  "version": "1.2.7",
  "identifier": "com.wu2kong.tinynote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TinyNote - 零碎笔记管理",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "macos-updater",
          "description": "Sparkle updater permissions for direct macOS distribution",
          "platforms": [
            "macOS"
          ],
          "windows": [
            "*"
          ],
          "permissions": [
            "sparkle-updater:default"
          ]
        }
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https: http:; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "infoPlist": "./Info.direct.plist",
      "frameworks": [
        "Sparkle.framework"
      ]
    }
  }
}
