{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.wu2kong.tinynote.app",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "appstore",
          "description": "Enables StoreKit purchases in the Mac App Store build",
          "platforms": ["macOS"],
          "windows": ["*"],
          "permissions": ["iap:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "entitlements": "./Entitlements.appstore.plist",
      "infoPlist": "./Info.appstore.plist",
      "hardenedRuntime": true
    }
  }
}
